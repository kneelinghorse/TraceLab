// ABOUTME: Dev container configuration for TraceLab development environment.
// ABOUTME: Uses docker-compose approach extending the existing docker-compose.dev.yml.
{
  "name": "TraceLab Dev",
  "dockerComposeFile": ["../docker-compose.dev.yml", "docker-compose.devcontainer.yml"],
  "service": "backend",
  "workspaceFolder": "/app",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [8000, 3000, 5433, 6333],
  "postCreateCommand": "pip install -e '.[dev,test]' && cd frontend && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "ms-playwright.playwright"
      ]
    }
  }
}
