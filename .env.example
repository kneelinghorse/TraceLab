# ------------------------------------------------------------------------------
# TraceLab Local Development Environment
# Copy this file to `.env` before running scripts/dev-setup.sh or docker compose.
# ------------------------------------------------------------------------------

# General application config
APP_NAME="TraceLab Research Repository"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracelab

# Vector database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=research_chunks_v2_3072d

# Authentication & security
SECRET_KEY=dev-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERNAME=tracelab-admin
AUTH_PASSWORD=changeme
AUTH_PASSWORD_HASH=
CORS_ALLOWED_ORIGINS_DEV=["http://localhost:3000"]
CORS_ALLOWED_ORIGINS_PROD=["https://namozine.com","https://www.namozine.com"]
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["Authorization","Content-Type"]
CORS_ALLOW_CREDENTIALS=true

# OpenAI / RAG configuration
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=3072
OPENAI_CHAT_MODEL=gpt-5.1
OPENAI_ESCALATION_MODEL=gpt-5.2
OPENAI_CHAT_TEMPERATURE=0.2
RAG_DEFAULT_MAX_TOKENS=350
RAG_CONTEXT_THRESHOLD=0.7
TIERED_ROUTING_THRESHOLD=0.85
TIERED_WEIGHT_LINGUISTIC=0.35
TIERED_WEIGHT_INTEGRITY=0.35
TIERED_WEIGHT_PROVENANCE=0.30

# Semantic cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_COLLECTION_NAME=semantic_cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ITEMS=20000

# Frontend defaults (used by scripts/dev-setup.sh if not overridden)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_PROJECT_ID=
