{
  "name": "Mission",
  "version": "0.1.0",
  "domain": "research.job",
  "description": "TraceLab mission: job in the research notebook. API provenance and unavailable trait fields are specified in the TraceLab OODS mapping contract.",
  "tags": [
    "research",
    "tracelab",
    "job"
  ],
  "maturity": "alpha",
  "traits": [
    {
      "name": "content/Labelled",
      "alias": null,
      "parameters": {
        "maxLabelLength": 255,
        "maxDescriptionLength": 1000
      }
    },
    {
      "name": "lifecycle/Stateful",
      "alias": null,
      "parameters": {
        "states": [
          "draft",
          "queued",
          "in_progress",
          "completed",
          "blocked",
          "cancelled",
          "validation_failed"
        ],
        "initialState": "draft"
      }
    },
    {
      "name": "lifecycle/Timestampable",
      "alias": null,
      "parameters": {
        "recordedEvents": [
          "created",
          "queued",
          "started",
          "completed",
          "updated"
        ],
        "timezone": "UTC"
      }
    },
    {
      "name": "structural/Ownerable",
      "alias": null,
      "parameters": {
        "ownerTypes": [
          "user"
        ],
        "primaryOwnerType": "user",
        "allowTransfer": false
      }
    },
    {
      "name": "behavioral/Taggable",
      "alias": null,
      "parameters": {
        "maxTags": 50,
        "allowCustomTags": true,
        "caseSensitive": true
      }
    },
    {
      "name": "lifecycle/Cancellable",
      "alias": null,
      "parameters": {
        "allowCancellationAfterStart": true,
        "requireReason": false
      }
    },
    {
      "name": "behavioral/Searchable",
      "alias": null,
      "parameters": {
        "placeholder": "Search missions"
      }
    },
    {
      "name": "behavioral/Filterable",
      "alias": null,
      "parameters": null
    },
    {
      "name": "behavioral/Pageable",
      "alias": null,
      "parameters": {
        "defaultPageSize": 20,
        "pageSizeOptions": [
          10,
          20,
          50,
          100
        ]
      }
    }
  ],
  "schema": {
    "label": {
      "type": "string",
      "required": true,
      "description": "Display projection of title; retain the complete source field.",
      "validation": {
        "maxLength": 255,
        "minLength": 3
      }
    },
    "description": {
      "type": "string",
      "required": true,
      "description": "Display projection of objective; never truncates persisted content.",
      "validation": {
        "minLength": 10
      }
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "description": "Hint copy surfaced in form fields when the label is empty.",
      "validation": {
        "maxLength": 80
      }
    },
    "status": {
      "type": "string",
      "required": true,
      "description": "Canonical research lifecycle. The API remains authoritative; do not coerce an unknown server value.",
      "validation": {
        "enum": [
          "draft",
          "queued",
          "in_progress",
          "completed",
          "blocked",
          "cancelled",
          "validation_failed"
        ]
      }
    },
    "state_history": {
      "type": "StateTransition[]",
      "required": false,
      "description": "Chronological log of state transitions. Each entry records the before/after states,\ntimestamp, and (when governance is enabled) the actor, reason, and transition metadata.\nRendered by StatusTimeline in the detail and timeline views.\n\nEntry structure:\n  - from: string (previous state)\n  - to: string (new state)\n  - timestamp: ISO 8601 datetime\n  - actor_id: string (user/system who triggered the transition, optional)\n  - reason: string (human-readable justification, required when requireTransitionReason is true)\n  - transition_metadata: Record<string, unknown> (arbitrary context, optional)\n",
      "default": []
    },
    "allowed_transitions": {
      "type": "string[]",
      "required": false,
      "description": "Materialized list of valid next states from the current status, computed from the\ntransitionRules parameter. When transitionRules is null (open model), this contains\nall states except the current one. Used by StatusSelector to disable invalid options\nand by StatusBadge to indicate available paths.\n",
      "default": []
    },
    "created_at": {
      "type": "datetime",
      "required": true,
      "description": "Created at.",
      "validation": {
        "format": "date-time"
      }
    },
    "updated_at": {
      "type": "datetime",
      "required": true,
      "description": "Updated at.",
      "validation": {
        "format": "date-time"
      }
    },
    "last_event": {
      "type": "string",
      "required": false,
      "description": "Only from an explicit event or timestamp projection; absence is unknown, not a fabricated audit event."
    },
    "last_event_at": {
      "type": "datetime",
      "required": false,
      "description": "Timestamp for the lifecycle event captured in last_event."
    },
    "owner_id": {
      "type": "uuid",
      "required": false,
      "description": "Authoritative nullable server owner_id. Not exposed by the current response; unavailable until the API exposes it. Never derive from created_by, user_id, or project owner."
    },
    "owner_type": {
      "type": "string",
      "required": false,
      "description": "user only when an authoritative owner_id is present.",
      "validation": {
        "enum": [
          "user"
        ]
      }
    },
    "ownership_role": {
      "type": "string",
      "required": false,
      "description": "Optional role name describing how the owner governs the entity.",
      "validation": {
        "maxLength": 80
      }
    },
    "ownership_transferred_at": {
      "type": "datetime",
      "required": false,
      "description": "Timestamp recording when ownership was last transferred."
    },
    "tags": {
      "type": "string[]",
      "required": false,
      "description": "Tags."
    },
    "tag_count": {
      "type": "number",
      "required": true,
      "description": "Computed number of tags assigned to the entity.",
      "default": 0,
      "validation": {
        "minimum": 0
      }
    },
    "tag_metadata": {
      "type": "object[]",
      "required": false,
      "description": "Per-tag governance metadata. Each entry corresponds to a tag in the tags array and\ntracks provenance and usage for taxonomy health monitoring.\n\nEntry structure:\n  - tag: string (the tag value, matches entry in tags array)\n  - created_at: ISO 8601 datetime\n  - created_by: string (user ID or \"system\" for allow-list tags)\n  - usage_count: number (how many entities use this tag, computed)\n  - moderation_status: \"approved\" | \"pending\" | \"rejected\" (when allowTagModeration is true)\n  - canonical_form: string (resolved synonym target, when synonymResolution is enabled)\n",
      "default": []
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "TraceLab cancellation is immediate; no billing period exists. Period-end controls must not be used."
    },
    "cancellation_reason": {
      "type": "string",
      "required": false,
      "description": "Free-form detail describing why cancellation occurred.",
      "validation": {
        "maxLength": 160
      }
    },
    "cancellation_reason_code": {
      "type": "string",
      "required": false,
      "description": "Structured reason code chosen from the allowedReasons parameter.",
      "validation": {
        "enumFromParameter": "allowedReasons"
      }
    },
    "cancellation_requested_at": {
      "type": "datetime",
      "required": false,
      "description": "Timestamp capturing when the cancellation workflow was initiated."
    },
    "searchQuery": {
      "type": "string",
      "required": false,
      "description": "The current search query string entered by the user.",
      "default": "",
      "validation": {
        "maxLength": 256
      }
    },
    "searchActive": {
      "type": "boolean",
      "required": false,
      "description": "Whether the search input is currently focused or has a non-empty query.",
      "default": false
    },
    "filters": {
      "type": "object[]",
      "required": false,
      "description": "Array of available filter descriptors. Each entry defines a filterable dimension:\n  - field: string (the schema field to filter on)\n  - label: string (display label)\n  - type: \"select\" | \"multi-select\" | \"range\" | \"boolean\" | \"date-range\"\n  - options: array of { value, label } for select/multi-select types\n",
      "default": []
    },
    "activeFilters": {
      "type": "object[]",
      "required": false,
      "description": "Array of currently applied filter values:\n  - field: string (matches a filter descriptor field)\n  - operator: \"eq\" | \"in\" | \"range\" | \"gt\" | \"lt\" | \"between\"\n  - value: unknown (the selected filter value or values)\n",
      "default": []
    },
    "filterCount": {
      "type": "number",
      "required": true,
      "description": "Computed count of currently active filters.",
      "default": 0,
      "validation": {
        "minimum": 0
      }
    },
    "page": {
      "type": "number",
      "required": true,
      "description": "Current page number (1-based).",
      "default": 1,
      "validation": {
        "minimum": 1
      }
    },
    "pageSize": {
      "type": "number",
      "required": true,
      "description": "Number of items displayed per page.",
      "default": 25,
      "validation": {
        "minimum": 1,
        "maximum": 500
      }
    },
    "totalItems": {
      "type": "number",
      "required": false,
      "description": "Total number of items across all pages. Used to compute total page count.",
      "default": 0,
      "validation": {
        "minimum": 0
      }
    },
    "totalPages": {
      "type": "number",
      "required": false,
      "description": "Computed total number of pages (ceil(totalItems / pageSize)).",
      "default": 0,
      "validation": {
        "minimum": 0
      }
    },
    "mission_id": {
      "type": "string",
      "required": true,
      "description": "Human-readable mission identifier (e.g., B16.1)",
      "validation": {
        "maxLength": 50,
        "minLength": 1
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "description": "Mission title",
      "validation": {
        "maxLength": 255,
        "minLength": 3
      }
    },
    "objective": {
      "type": "string",
      "required": true,
      "description": "What this mission aims to achieve (minimum 10 characters)",
      "validation": {
        "minLength": 10
      }
    },
    "success_criteria": {
      "type": "string[]",
      "required": true,
      "description": "Array of measurable success conditions",
      "validation": {
        "minItems": 1
      }
    },
    "id": {
      "type": "uuid",
      "required": true,
      "description": "Id.",
      "validation": {
        "format": "uuid"
      }
    },
    "project_id": {
      "type": "uuid",
      "required": false,
      "description": "Project id."
    },
    "project_name": {
      "type": "string",
      "required": false,
      "description": "Name of the associated project"
    },
    "context": {
      "type": "object",
      "required": false,
      "description": "Context."
    },
    "deliverables": {
      "type": "string[]",
      "required": false,
      "description": "Deliverables."
    },
    "research_phases": {
      "type": "object",
      "required": false,
      "description": "Research phases."
    },
    "metadata": {
      "type": "object",
      "required": false,
      "description": "Metadata."
    },
    "background": {
      "type": "string",
      "required": false,
      "description": "Background."
    },
    "focus": {
      "type": "string",
      "required": false,
      "description": "Focus."
    },
    "references": {
      "type": "object[]",
      "required": false,
      "description": "References."
    },
    "required_entities": {
      "type": "string[]",
      "required": false,
      "description": "Required entities."
    },
    "excluded_entities": {
      "type": "string[]",
      "required": false,
      "description": "Excluded entities."
    },
    "expected_output_schema": {
      "type": "object",
      "required": false,
      "description": "Expected output schema."
    },
    "coverage_thresholds": {
      "type": "object",
      "required": false,
      "description": "Coverage thresholds."
    },
    "validation_thresholds": {
      "type": "object",
      "required": false,
      "description": "Validation thresholds."
    },
    "deliverable_format": {
      "type": "string",
      "required": false,
      "description": "Deliverable format."
    },
    "max_loops": {
      "type": "number",
      "required": false,
      "description": "Max loops."
    },
    "min_loops": {
      "type": "number",
      "required": false,
      "description": "Min loops."
    },
    "constraints": {
      "type": "string[]",
      "required": false,
      "description": "Constraints."
    },
    "queued_at": {
      "type": "datetime",
      "required": false,
      "description": "Queued at."
    },
    "started_at": {
      "type": "datetime",
      "required": false,
      "description": "Started at."
    },
    "completed_at": {
      "type": "datetime",
      "required": false,
      "description": "Completed at."
    },
    "deepsearch_job_id": {
      "type": "string",
      "required": false,
      "description": "Deepsearch job id."
    },
    "execution_metadata": {
      "type": "object",
      "required": false,
      "description": "Execution metadata."
    },
    "result_document_ids": {
      "type": "uuid[]",
      "required": false,
      "description": "Result document ids."
    },
    "result_report_id": {
      "type": "uuid",
      "required": false,
      "description": "Result report id."
    },
    "result_markdown": {
      "type": "string",
      "required": false,
      "description": "Result markdown."
    },
    "result_protocol": {
      "type": "object",
      "required": false,
      "description": "Result protocol."
    },
    "error_message": {
      "type": "string",
      "required": false,
      "description": "Error message."
    },
    "created_by": {
      "type": "string",
      "required": false,
      "description": "Created by."
    },
    "progress_percent": {
      "type": "number",
      "required": false,
      "description": "Progress percent."
    },
    "current_phase": {
      "type": "string",
      "required": false,
      "description": "Current phase."
    },
    "deepsearch_attempt_count": {
      "type": "number",
      "required": false,
      "description": "Deepsearch attempt count.",
      "default": 0
    },
    "lease_expires_at": {
      "type": "datetime",
      "required": false,
      "description": "Lease expires at."
    },
    "materialization_pending": {
      "type": "boolean",
      "required": true,
      "description": "Materialization pending."
    },
    "materialization_status": {
      "type": "string",
      "required": false,
      "description": "Materialization status."
    },
    "materialization_attempt_count": {
      "type": "number",
      "required": false,
      "description": "Materialization attempt count.",
      "default": 0
    },
    "materialization_error": {
      "type": "string",
      "required": false,
      "description": "Materialization error."
    },
    "search_ready": {
      "type": "boolean",
      "required": true,
      "description": "Search ready."
    }
  },
  "semantics": {
    "label": {
      "semantic_type": "text.label",
      "token_mapping": "tokenMap(text.label.*)",
      "ui_hints": {
        "component": "TextHeading",
        "maxLengthParameter": "maxLabelLength",
        "headingLevel": 2
      }
    },
    "description": {
      "semantic_type": "text.description",
      "token_mapping": "tokenMap(text.body.*)",
      "ui_hints": {
        "component": "TextBody",
        "maxLengthParameter": "maxDescriptionLength"
      }
    },
    "placeholder": {
      "semantic_type": "text.placeholder",
      "token_mapping": "tokenMap(text.placeholder.*)",
      "ui_hints": {
        "component": "FormHint",
        "maxLength": 80
      }
    },
    "status": {
      "semantic_type": "status.state",
      "token_mapping": "tokenMap(status.state.*)",
      "ui_hints": {
        "component": "StatusBadge",
        "showIcon": true
      }
    },
    "state_history": {
      "semantic_type": "timeline.state_transition",
      "token_mapping": "tokenMap(timeline.status.*)",
      "ui_hints": {
        "component": "StatusTimeline",
        "collapseWhenEmpty": true
      }
    },
    "allowed_transitions": {
      "semantic_type": "status.navigation",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "StatusSelector",
        "description": "Drives the set of enabled options in the state transition UI."
      }
    },
    "created_at": {
      "semantic_type": "audit.created_at",
      "token_mapping": "tokenMap(audit.created)",
      "ui_hints": {
        "component": "TimelineTimestamp",
        "timezoneParameter": "timezone"
      }
    },
    "updated_at": {
      "semantic_type": "audit.updated_at",
      "token_mapping": "tokenMap(audit.updated)",
      "ui_hints": {
        "component": "TimelineTimestamp",
        "timezoneParameter": "timezone",
        "allowNullParameter": "allowNullUpdatedAt"
      }
    },
    "last_event": {
      "semantic_type": "audit.event.type",
      "token_mapping": "tokenMap(audit.event.*)",
      "ui_hints": {
        "component": "AuditBadge",
        "parameterSource": "recordedEvents"
      }
    },
    "last_event_at": {
      "semantic_type": "audit.event.timestamp",
      "token_mapping": "tokenMap(audit.event.timestamp)",
      "ui_hints": {
        "component": "TimelineTimestamp",
        "timezoneParameter": "timezone"
      }
    },
    "owner_id": {
      "semantic_type": "ownership.owner.id",
      "token_mapping": "tokenMap(ownership.owner.id)",
      "ui_hints": {
        "component": "OwnerReference",
        "ownerTypeField": "owner_type"
      }
    },
    "owner_type": {
      "semantic_type": "ownership.owner.type",
      "token_mapping": "tokenMap(ownership.owner.type)",
      "ui_hints": {
        "component": "OwnerTypeBadge",
        "parameterSource": "ownerTypes"
      }
    },
    "ownership_role": {
      "semantic_type": "ownership.owner.role",
      "token_mapping": "tokenMap(ownership.owner.role)",
      "ui_hints": {
        "component": "OwnerRolePill"
      }
    },
    "ownership_transferred_at": {
      "semantic_type": "ownership.owner.transferred_at",
      "token_mapping": "tokenMap(ownership.owner.timestamp)",
      "ui_hints": {
        "component": "TimelineTimestamp"
      }
    },
    "tags": {
      "semantic_type": "taxonomy.tag.collection",
      "token_mapping": "tokenMap(taxonomy.tag.*)",
      "ui_hints": {
        "component": "TagCollection",
        "allowCreateParameter": "allowCustomTags",
        "allowListParameter": "allowedTags",
        "caseSensitiveParameter": "caseSensitive"
      }
    },
    "tag_count": {
      "semantic_type": "metric.collection.count",
      "token_mapping": "tokenMap(taxonomy.tag.count)",
      "ui_hints": {
        "component": "MetricBadge",
        "format": "integer"
      }
    },
    "tag_metadata": {
      "semantic_type": "taxonomy.tag.governance",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "TagGovernancePanel",
        "description": "Admin panel for reviewing tag health, moderation queue, and synonym resolution."
      }
    },
    "cancel_at_period_end": {
      "semantic_type": "status.cancel.deferred",
      "token_mapping": "tokenMap(status.cancel.*)",
      "ui_hints": {
        "component": "CancellationToggle",
        "emphasizeWhenTrue": true
      }
    },
    "cancellation_reason": {
      "semantic_type": "status.cancel.reason",
      "token_mapping": "tokenMap(status.cancel.reason)",
      "ui_hints": {
        "component": "CancellationReason",
        "multiline": true,
        "maxLength": 160
      }
    },
    "cancellation_reason_code": {
      "semantic_type": "status.cancel.reason_code",
      "token_mapping": "tokenMap(status.cancel.code.*)",
      "ui_hints": {
        "component": "ReasonPicker",
        "parameterSource": "allowedReasons"
      }
    },
    "cancellation_requested_at": {
      "semantic_type": "status.cancel.timestamp",
      "token_mapping": "tokenMap(status.cancel.timestamp)",
      "ui_hints": {
        "component": "TimelineTimestamp"
      }
    },
    "searchQuery": {
      "semantic_type": "input.search.query",
      "token_mapping": "tokenMap(search.input.*)",
      "ui_hints": {
        "component": "SearchInput",
        "placeholderParameter": "placeholder",
        "debounceParameter": "debounceMs"
      }
    },
    "searchActive": {
      "semantic_type": "state.search.active",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "SearchInput",
        "description": "Drives visual active/inactive state of the search region."
      }
    },
    "filters": {
      "semantic_type": "input.filter.descriptors",
      "token_mapping": "tokenMap(filter.panel.*)",
      "ui_hints": {
        "component": "FilterPanel",
        "modeParameter": "filterMode"
      }
    },
    "activeFilters": {
      "semantic_type": "state.filter.active",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "FilterPanel",
        "description": "Drives active filter chip display and clear actions."
      }
    },
    "filterCount": {
      "semantic_type": "metric.filter.count",
      "token_mapping": "tokenMap(filter.badge.*)",
      "ui_hints": {
        "component": "MetricBadge",
        "format": "integer"
      }
    },
    "page": {
      "semantic_type": "state.pagination.page",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "PaginationBar",
        "description": "Current active page, drives page button highlight state."
      }
    },
    "pageSize": {
      "semantic_type": "state.pagination.pageSize",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "PaginationBar",
        "defaultParameter": "defaultPageSize"
      }
    },
    "totalItems": {
      "semantic_type": "metric.pagination.totalItems",
      "token_mapping": "tokenMap(pagination.info.*)",
      "ui_hints": {
        "component": "PaginationBar",
        "format": "integer"
      }
    },
    "totalPages": {
      "semantic_type": "metric.pagination.totalPages",
      "token_mapping": "computed",
      "ui_hints": {
        "component": "PaginationBar",
        "description": "Computed from totalItems and pageSize."
      }
    },
    "title": {
      "semantic_type": "text.label",
      "token_mapping": "tokenMap(text.label.*)"
    },
    "project_id": {
      "semantic_type": "research.mission.project_id",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "mission_id": {
      "semantic_type": "research.mission.mission_id",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "objective": {
      "semantic_type": "research.mission.objective",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "success_criteria": {
      "semantic_type": "research.mission.success_criteria",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "id": {
      "semantic_type": "research.mission.id",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "project_name": {
      "semantic_type": "research.mission.project_name",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "context": {
      "semantic_type": "research.mission.context",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "deliverables": {
      "semantic_type": "research.mission.deliverables",
      "token_mapping": "tokenMap(text.body.*)"
    },
    "research_phases": {
      "semantic_type": "research.mission.research_phases",
