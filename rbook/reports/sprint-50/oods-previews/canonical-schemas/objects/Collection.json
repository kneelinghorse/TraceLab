    "pagination.selector.border": "var(--sys-border-default)"
  },
  "warnings": [
    "Field collision: \"description\" in object schema overrides trait definition",
    "Field collision: \"created_at\" in object schema overrides trait definition",
    "Field collision: \"updated_at\" in object schema overrides trait definition",
    "Field collision: \"label\" in object schema overrides trait definition",
    "Field collision: \"owner_id\" in object schema overrides trait definition",
    "Field collision: \"owner_type\" in object schema overrides trait definition",
    "Field collision: \"last_event\" in object schema overrides trait definition"
  ],
  "filePath": "/private/tmp/tracelab-ux1-forge/objects/research/Collection.object.yaml"
}
