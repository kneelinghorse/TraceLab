{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepsearch.local/schemas/expected_output_schema.schema.json",
  "title": "DeepSearch expected_output_schema",
  "description": "Authoring schema for mission_context.expected_output_schema. This authored input is normalized into internal OutputSchema objects; internal source_text is omitted here on purpose.",
  "oneOf": [
    {
      "$ref": "#/$defs/outputSchemaItem"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outputSchemaItem"
      }
    }
  ],
  "$defs": {
    "outputSchemaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "format"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "min_items": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entity_extraction_required": {
          "type": "boolean"
        },
        "entity_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation_required": {
          "type": "boolean"
        },
        "evidence_gaps_section_required": {
          "type": "boolean"
        },
        "corpus_reference_required": {
          "type": "boolean"
        },
        "claim_to_evidence_mapping_required": {
          "type": "boolean"
        },
        "limitations_section_required": {
          "type": "boolean"
        },
        "minimum_citation_count": {
          "type": "integer",
          "minimum": 1
        },
        "row_identifier_column": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
