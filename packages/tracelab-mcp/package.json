{
  "name": "@tracelab/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for TraceLab - enables AI agents to perform research-to-output loops",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tracelab-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tracelab",
    "ai-agent",
    "research",
    "knowledge-base"
  ],
  "author": "TraceLab",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
