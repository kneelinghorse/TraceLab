{
  "name": "@aquex/tracelab-mcp",
  "version": "1.1.1",
  "description": "MCP server for TraceLab — gives AI agents research-to-output loops against a TraceLab knowledge base. Eight action-clustered tools (search, project, collection, report, document, mission, mission-execution, evidence) and an RFC 8628 device-code login so installers don't hand-paste API keys.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tracelab-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tracelab",
    "aquex",
    "ai-agent",
    "research",
    "knowledge-base",
    "claude",
    "claude-desktop",
    "claude-code",
    "rag"
  ],
  "author": "Aquex",
  "license": "MIT",
  "homepage": "https://github.com/kneelinghorse/TraceLab/tree/main/packages/tracelab-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kneelinghorse/TraceLab.git",
    "directory": "packages/tracelab-mcp"
  },
  "bugs": {
    "url": "https://github.com/kneelinghorse/TraceLab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ]
}
