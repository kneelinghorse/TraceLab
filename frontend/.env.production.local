# Production reference configuration for the Mission Protocol UI
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Cloudflare vanity domain pointing at the FastAPI backend (base domain only)
NEXT_PUBLIC_API_BASE_URL=https://api.tracelab.aquex.ai
# API path prefix (set to "" when the backend exposes routes at the domain root)
NEXT_PUBLIC_API_PATH_PREFIX=/api/v1

# Replace with the canonical project UUID returned by GET /projects
NEXT_PUBLIC_DEFAULT_PROJECT_ID=<production-project-uuid>

# Railway injects PORT automatically; keep for local parity/testing
PORT=3000
