# Mission Protocol UI (Railway) production variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# FastAPI backend exposed via Cloudflare (base domain only; UI appends /api/v1 paths)
NEXT_PUBLIC_API_BASE_URL=https://api.namozine.com
# Railway fallback (uncomment only during incident response, base domain only)
# NEXT_PUBLIC_API_BASE_URL=https://tracelab-production.up.railway.app

# Optional default project selection for Mission Protocol form
NEXT_PUBLIC_DEFAULT_PROJECT_ID=<production-project-uuid>

# Railway injects PORT automatically; keep for local parity/testing
PORT=3000
