# Mission Protocol UI (Railway) production variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# FastAPI backend exposed via Cloudflare (include /api/v1 prefix)
NEXT_PUBLIC_API_BASE_URL=https://api.namozine.com/api/v1
# Railway fallback (uncomment only during incident response)
# NEXT_PUBLIC_API_BASE_URL=https://tracelab-production.up.railway.app/api/v1

# Optional default project selection for Mission Protocol form
NEXT_PUBLIC_DEFAULT_PROJECT_ID=<production-project-uuid>

# Railway injects PORT automatically; keep for local parity/testing
PORT=3000
