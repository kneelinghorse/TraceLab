# Mission Protocol UI (Railway) production variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# FastAPI backend exposed via Railway (include /api/v1 prefix)
NEXT_PUBLIC_API_BASE_URL=https://<fastapi-service-domain>/api/v1

# Optional default project selection for Mission Protocol form
NEXT_PUBLIC_DEFAULT_PROJECT_ID=<project-uuid-from-projects-table>

# Railway injects PORT automatically; keep for local parity/testing
PORT=3000
